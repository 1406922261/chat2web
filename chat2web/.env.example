# OpenAI 兼容 LLM 配置（必填）
# 示例 1：超算互联网 Token Plan
#   LLM_BASE_URL=https://api.scnet.cn/api/llm/v1
#   LLM_MODEL=DeepSeek-V4.1-Flash-1017-Event
# 示例 2：火山方舟
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://api.scnet.cn/api/llm/v1
LLM_API_KEY=
LLM_MODEL=DeepSeek-V4.1-Flash-1017-Event

# 生成参数
LLM_TEMPERATURE=0.4
# 单次响应最大输出 token，避免大文件写到一半被截断后重试（留空则使用服务端默认值）
LLM_MAX_TOKENS=8192
MAX_AGENT_STEPS=32
MAX_TOOL_CALLS=90

# Shell 限制
SHELL_TIMEOUT_SECONDS=300
MAX_OUTPUT_CHARS=24000

# 可选：设为 1 时不自动打开浏览器（便于测试）
# CHAT2WEB_NO_OPEN=1
LLM_TIMEOUT_SECONDS=240
